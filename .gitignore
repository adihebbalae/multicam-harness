# Run outputs — stay on the machine / NAS, never in git
results/
outputs/
logs/
runs/
remux*.jsonl

# Raw data / video / weights (anchored: unanchored `data/` also hits scripts/data/)
/data/*
!/data/subsets/
*.avi
*.mp4
*.mp4.bad
*.pt
*.bin
*.safetensors
*.tar
*.tar.gz
*.zip

# Figures are regenerable; commit only deliberately under figures/
*.png
*.jpg
*.jpeg
!figures/*.png
!figures/*.jpg
# ...but the sweep figure scripts regenerate a whole directory (png/pdf/svg)
figures/frame_sweep/

# Python
__pycache__/
*.pyc
.venv/
venv/
.python-version
.ipynb_checkpoints/

# Secrets
.env
*.key

# demo showcase: the rendered camera-wall clips are part of the deliverable
# (so are the figures and the wall snapshots, against the blanket *.png rule)
!/demo/**/*.png
!/demo/figs_demo/walls/*.mp4
!/demo/figs_demo_viclip/walls/*.mp4
